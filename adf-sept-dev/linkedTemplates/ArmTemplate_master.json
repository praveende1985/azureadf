{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-sept-dev"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"NewSqlServer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'NewSqlServer'"
		},
		"ls_target_increment_database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_target_increment_database'"
		},
		"lsadls_soruce_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lsadls_soruce'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserversept.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sampledb"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"NewSqlServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserversept.database.windows.net"
		},
		"NewSqlServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sampledb"
		},
		"NewSqlServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_target_increment_database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserversept.database.windows.net"
		},
		"ls_target_increment_database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "TargetDb"
		},
		"ls_target_increment_database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"lsadls_soruce_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlssep2025praveen.dfs.core.windows.net"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-sept-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"NewSqlServer_password": {
						"value": "[parameters('NewSqlServer_password')]"
					},
					"ls_target_increment_database_password": {
						"value": "[parameters('ls_target_increment_database_password')]"
					},
					"lsadls_soruce_accountKey": {
						"value": "[parameters('lsadls_soruce_accountKey')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"NewSqlServer_properties_typeProperties_server": {
						"value": "[parameters('NewSqlServer_properties_typeProperties_server')]"
					},
					"NewSqlServer_properties_typeProperties_database": {
						"value": "[parameters('NewSqlServer_properties_typeProperties_database')]"
					},
					"NewSqlServer_properties_typeProperties_userName": {
						"value": "[parameters('NewSqlServer_properties_typeProperties_userName')]"
					},
					"ls_target_increment_database_properties_typeProperties_server": {
						"value": "[parameters('ls_target_increment_database_properties_typeProperties_server')]"
					},
					"ls_target_increment_database_properties_typeProperties_database": {
						"value": "[parameters('ls_target_increment_database_properties_typeProperties_database')]"
					},
					"ls_target_increment_database_properties_typeProperties_userName": {
						"value": "[parameters('ls_target_increment_database_properties_typeProperties_userName')]"
					},
					"lsadls_soruce_properties_typeProperties_url": {
						"value": "[parameters('lsadls_soruce_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-sept-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-sept-dev_ArmTemplate_0')]"
			]
		}
	]
}